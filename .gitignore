*.o
*.a
fleet_dt_test_*
examples/daemon
examples/two_paths
# The benchmark binaries have no extension, so the pattern that hides them
# also hides their sources. Both are re-included explicitly; forgetting the
# header once left a fresh clone unable to build the benchmarks.
tools/bench/bench_*
!tools/bench/bench_*.c
!tools/bench/bench_*.h
results/selftest/
tools/report/report
fleet_dt_it_mqtt

# The WeBots controller binary sits beside its source, because that is where
# the simulator looks for it; and WeBots writes a .wbproj next to the world to
# remember viewport state. Neither belongs in the repository.
adapters/webots/controllers/*/[!.]*
!adapters/webots/controllers/*/*.c
!adapters/webots/controllers/*/*.h
adapters/webots/worlds/.*.wbproj
*.d
