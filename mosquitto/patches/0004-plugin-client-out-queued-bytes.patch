+BROKER_EXPORT int64_t mosquitto_client_out_queued_bytes(const struct mosquitto *client)
+{
+	struct mosquitto *mosq = (struct mosquitto *)client;
+	struct mosquitto__packet *packet;
+	int64_t bytes = 0;
+
+	if(!mosq){
+		return -1;
+	}
+	COMPAT_pthread_mutex_lock(&mosq->out_packet_mutex);
+	for(packet = mosq->out_packet; packet; packet = packet->next){
+		bytes += packet->to_process;
+	}
+	COMPAT_pthread_mutex_unlock(&mosq->out_packet_mutex);
+	return bytes;
+}
