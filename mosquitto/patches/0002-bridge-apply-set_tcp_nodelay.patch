+
+/* Disable Nagle's algorithm on the bridge socket when set_tcp_nodelay is
+ * true, as is already done for the sockets accepted by the listeners. Small
+ * QoS 1/2 PUBLISH and acknowledgement packets of a bridge then leave the host
+ * without waiting for the acknowledgement of previous segments. */
+static int bridge__set_tcp_nodelay(struct mosquitto *context)
+{
+	int flag = 1;
+
+	if(!db.config->set_tcp_nodelay || context->sock == INVALID_SOCKET){
+		return MOSQ_ERR_SUCCESS;
+	}
+#ifdef WIN32
+	if(setsockopt(context->sock, IPPROTO_TCP, TCP_NODELAY, (char *)&flag, sizeof(int)) != 0){
+#else
+	if(setsockopt(context->sock, IPPROTO_TCP, TCP_NODELAY, &flag, sizeof(int)) != 0){
+#endif
+		log__printf(NULL, MOSQ_LOG_WARNING, "Warning: Unable to set TCP_NODELAY on bridge %s.", context->bridge->name);
+	}
+	return MOSQ_ERR_SUCCESS;
+}
