[Unit]
Description=Fleet-DT virtual environment (VE) and DTA
After=fleetdt-gs-broker.service
Requires=fleetdt-gs-broker.service

[Service]
EnvironmentFile=/etc/fleetdt/fleetdt.env
WorkingDirectory=/opt/fleet-dt/src
ExecStart=/usr/bin/python3 -m fleetdt.ve live --broker 127.0.0.1:1883 --dtp ${FDT_DTP} --dta ${FDT_DATA}/dta.jsonl --port 8080
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
