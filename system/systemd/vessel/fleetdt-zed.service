[Unit]
Description=Fleet-DT video publisher (ZED camera)
After=fleetdt-broker.service
Requires=fleetdt-broker.service

[Service]
EnvironmentFile=/etc/fleetdt/fleetdt.env
ExecStart=/usr/bin/python3 /opt/fleet-dt/src/vessel/publishers/zed_publisher.py --dtp ${FDT_DTP} --vessel ${FDT_VESSEL} --device /dev/video0 --quality 50
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
