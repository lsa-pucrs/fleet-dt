# The injector keeps no network interface on the radio: tx99.sh creates the monitor
# interface that the TX99 mode of ath9k needs and sets the channel of the fleet.
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/ahb/18100000.wmac'
	option band '2g'
	option channel '6'
	option htmode 'HT20'
	option country 'BR'
	option disabled '1'
