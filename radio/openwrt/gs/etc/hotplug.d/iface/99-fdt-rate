#!/bin/sh
# fixed legacy rate of 24 Mbit/s (R_PHY of dtp.json) on the wireless interface of the fleet
[ "$ACTION" = ifup ] || exit 0
for dev in $(iw dev | awk '$1 == "Interface" { print $2 }'); do
	iw dev "$dev" set bitrates legacy-2.4 24 2>/dev/null && logger -t fdt-rate "$dev: legacy 24 Mbit/s"
	iw dev "$dev" set power_save off 2>/dev/null || true
done
