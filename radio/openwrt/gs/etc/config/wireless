config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/ahb/18100000.wmac'
	option band '2g'
	option channel '6'
	option htmode 'NOHT'
	option country 'BR'
	option txpower '20'
	option distance '1000'
	option noscan '1'
	option legacy_rates '0'
	option basic_rate '24000'
	option supported_rates '24000'

config wifi-iface 'fleet'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option wds '1'
	option ssid 'fleet-dt'
	option encryption 'psk2+ccmp'
	option key 'CHANGE_ME'
	option disassoc_low_ack '0'
	option max_inactivity '30'
