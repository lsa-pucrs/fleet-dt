#!/bin/sh /etc/rc.common
# Fleet-DT channel monitor (fdt_chmon) of the GS radio
START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load fdt-chmon
	local enabled iface dtp broker record
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get iface main iface wlan0
	config_get dtp main dtp /etc/fleetdt/dtp.json
	config_get broker main broker 192.168.1.10:1883
	config_get record main record ''
	procd_open_instance
	procd_set_param command /usr/bin/fdt_chmon --dtp "$dtp" --iface "$iface" --broker "$broker"
	[ -n "$record" ] && procd_append_param command --record "$record"
	procd_set_param respawn 3600 2 0
	procd_set_param stderr 1
	procd_close_instance
}
